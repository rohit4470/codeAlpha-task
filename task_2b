#include <iostream>
#include <vector>
#include <string>
using namespace std;

struct Student {
    int rollNo;
    string name;
    float marks;
    char grade;
};

char calculateGrade(float marks) {
    if (marks >= 90) return 'A';
    else if (marks >= 75) return 'B';
    else if (marks >= 60) return 'C';
    else if (marks >= 40) return 'D';
    else return 'F';
}

int main() {
    vector<Student> students;
    int choice;

    while (true) {
        cout << "\n====================================\n";
        cout << "  Task 2: Student Management System \n";
        cout << "====================================\n";
        cout << "1. Add Student\n";
        cout << "2. View All Students\n";
        cout << "3. Exit\n";
        cout << "Option select karein (1-3): ";
        cin >> choice;

        if (choice == 1) {
            Student s;
            cout << "Roll Number: ";
            cin >> s.rollNo;
            cout << "Name: ";
            cin.ignore();
            getline(cin, s.name);
            cout << "Marks (0-100): ";
            cin >> s.marks;

            s.grade = calculateGrade(s.marks);
            students.push_back(s);
            cout << "✅ Student Successfully Add Ho Gaya!\n";
        } 
        else if (choice == 2) {
            if (students.empty()) {
                cout << "⚠️ Koi student record nahi mila!\n";
            } else {
                cout << "\n--- Student Records ---\n";
                for (const auto &s : students) {
                    cout << "Roll No: " << s.rollNo 
                         << " | Name: " << s.name 
                         << " | Marks: " << s.marks 
                         << " | Grade: " << s.grade << "\n";
                }
            }
        } 
        else if (choice == 3) {
            cout << "Program closed. All the best!\n";
            break;
        } 
        else {
            cout << "❌ Galat option! Phir se try karein.\n";
        }
    }

    return 0;
}
